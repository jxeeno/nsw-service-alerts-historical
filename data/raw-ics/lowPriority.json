    "urlText": "L1 John Street Square lift out of service",
    "url": "https://transportnsw.info/alerts/details#/ems-42893",
    "content": "<div>\n<div>The lift on the John Street Square light rail platform towards Dulwich Hill is temporarily out of service until further notice.</div>\n<div>&nbsp;</div>\n<div>For your safety, do not use even if doors open.</div>\n<div>&nbsp;</div>\n<div>Alternative access:</div>\n<div>Use the stairs,<br />&middot;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;Or use the lift on the opposite platform</div>\n<div>&nbsp;</div>\n<div>For urgent assistance:</div>\n<div>Use the Help Point if on the platform<br />&middot;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;Or call 131 500</div>\n</div>",
    "subtitle": "L1 John Street Square lift out of service",
    "properties": {
      "smsText": "L1 John Street Square lift out of service",
      "speechText": "The lift on the John Street Square light rail platform towards Dulwich Hill is temporarily out of service until further notice. For your safety, do not use even if the doors open. For alternative access, use the stairs if able to, or use the lift on the opposite platform. For urgent assistance, use the Help Point if on the platform, or call 131 500.",
      "announcementType": "liftsEscalators",
      "publishToAreas": "1",
      "stopIDglobalID": "200948",
      "providerCode": "TfNSW"
    },
